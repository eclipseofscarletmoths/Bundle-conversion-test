<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BundleDoctor</AssemblyName>
    <RootNamespace>BundleDoctor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Schema-driven asset/bundle reading & writing -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.2" />

    <!-- Used only to resolve inline vs. .resS Texture2D image data. The actual compressed
         texture decoding is delegated to the Unity-specific Kyaru decoder below. -->
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />

    <!-- Unity Texture2D decoder. The Linux native package supplies libTexture2DDecoderNative.so
         for the ubuntu-latest runner. Kyaru's API is the same decoder used by AssetStudio and
         exposes explicit UnityCrunch unpacking for DXT5Crunched. -->
    <PackageReference Include="Kyaru.Texture2DDecoder" Version="0.17.1" />
    <PackageReference Include="Kyaru.Texture2DDecoder.Linux" Version="0.2.0" />
  </ItemGroup>

</Project>
